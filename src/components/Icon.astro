---
const { name = 'cube' } = Astro.props;
---
{ name === 'cube' && (
  <svg viewBox="0 0 27 32" aria-hidden="true" focusable="false">
    <path d="M26.9023 7.76562V23.2979L13.4512 31.0645L0 23.2979V7.76562L13.4512 0L26.9023 7.76562ZM1 8.34277V22.7197L13.4512 29.9092L25.9023 22.7197V8.34277L13.4512 1.1543L1 8.34277Z" fill="currentColor"/>
  </svg>
)}
{ name === 'logo' && (
  <img src="/logos/forgepool-icon.svg" alt="" aria-hidden="true" />
)}
{ name === 'mail' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M4 6.5h16v11H4v-11Zm1.6 1.4 6.4 4.6 6.4-4.6H5.6Zm12.8 8.2V9.6L12 14.2 5.6 9.6v6.5h12.8Z" fill="currentColor"/>
  </svg>
)}
{ name === 'bell' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 21a2.7 2.7 0 0 0 2.6-2h-5.2A2.7 2.7 0 0 0 12 21Zm7-5.5-1.9-2.1V9.2a5.1 5.1 0 0 0-4.1-5V2.8a1 1 0 1 0-2 0v1.4a5.1 5.1 0 0 0-4.1 5v4.2L5 15.5V17h14v-1.5ZM8.5 15.4l.2-.2V9.2a3.3 3.3 0 1 1 6.6 0v6l.2.2h-7Z" fill="currentColor"/>
  </svg>
)}
{ name === 'external' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M7 7h5v1.7H9.9l4.5 4.5-1.2 1.2-4.5-4.5V12H7V7Zm2 11h8V9h-2V7h4v13H7v-4h2v2Z" fill="currentColor"/>
  </svg>
)}
{ name === 'check' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M10.1 15.6 6.9 12.4l-1.2 1.2 4.4 4.4 8.2-8.2-1.2-1.2-7 7Z" fill="currentColor"/>
  </svg>
)}
{ name === 'shield' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 3 5 6.5v5.1c0 4.2 2.8 7.9 7 9.4 4.2-1.5 7-5.2 7-9.4V6.5L12 3Zm5.3 8.6c0 3.2-2.1 6.2-5.3 7.6-3.2-1.4-5.3-4.4-5.3-7.6v-4L12 5l5.3 2.6v4Z" fill="currentColor"/>
  </svg>
)}

{ name === 'pulse' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M4 13.2h3.4l1.8-4.6 4 9.2 2.1-4.6H20v1.7h-3.6l-3.1 6.8-4-9.2-.8 2.4H4v-1.7Z" fill="currentColor"/>
  </svg>
)}
{ name === 'clock' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 1.7a6.3 6.3 0 1 1 0 12.6 6.3 6.3 0 0 1 0-12.6Zm.8 2.9h-1.6v4.2l3.6 2.2.8-1.3-2.8-1.7V8.6Z" fill="currentColor"/>
  </svg>
)}

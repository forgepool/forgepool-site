---
import { getBlogLabel } from "../config/blogLabels";
import NewPublicationBadge from "./NewPublicationBadge.astro";

const { posts = [] } = Astro.props;

function formatDate(date) {
  return date.toLocaleDateString("de-DE", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<section class="archive-panel">
  <div class="archive-head">
    <div>
      <h2>Journal Archiv</h2>

      <p>
        Alle bisherigen Notizen, Architekturentscheidungen und Fortschritte
        im Aufbau von ForgePool
      </p>
    </div>

    <a href="/blog/" class="archive-all">
      Alle Beiträge &gt;
    </a>
  </div>

  <div class="archive-list">
    {
      posts.map((post) => {
        const label = getBlogLabel(post.data.labelId);

        return (
          <a href={`/blog/${post.id}/`} class="archive-row">
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>

            <strong class="archive-title">
              <span>{post.data.title}</span>

              <NewPublicationBadge
                publishedAt={post.data.publishedAt}
                class="tag tag-new"
              />
            </strong>

            <span class={`tag tag-${label.tagClass}`}>
              {label.name}
            </span>

            <p>{post.data.description}</p>

            <span class="archive-arrow" aria-hidden="true">
              →
            </span>
          </a>
        );
      })
    }
  </div>
</section>

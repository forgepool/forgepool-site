---
import NewPublicationBadge from "./NewPublicationBadge.astro";

const {
  eyebrow,
  title,
  text,
  href = "#",
  image,
  publishedAt,
} = Astro.props;

const style = image ? `--feature-image: url('${image}')` : undefined;
---
<a
  class:list={["feature-card", { "has-cover": Boolean(image) }]}
  href={href}
  aria-label={`Artikel öffnen: ${title}`}
  style={style}
>
  <NewPublicationBadge
    publishedAt={publishedAt}
    class="feature-new-badge"
  />

  <div class="feature-card-content">
    <p class="feature-card-meta">{eyebrow}</p>
    <h3>{title}</h3>
    <span>{text}</span>
  </div>
</a>

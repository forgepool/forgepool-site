---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import JournalArchive from "../components/JournalArchive.astro";
import SubscribeForm from "../components/SubscribeForm.astro";

import { getBlogLabel } from "../config/blogLabels";
import { selectBlogHighlights } from "../lib/publicationPresentation.mjs";

const posts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft,
  )
).sort(
  (a, b) =>
    b.data.date.valueOf() -
    a.data.date.valueOf(),
);

const highlights =
  selectBlogHighlights(
    posts,
  );

function formatFeaturedDate(date) {
  return date.toLocaleDateString(
    "de-DE",
    {
      day: "numeric",
      month: "short",
    },
  );
}

---

<BaseLayout
  title="ForgePool Engineering Journal"
  active="blog"
  background="desert"
  pageClass="blog-page"
>
  <Fragment slot="header">
    <Header active="blog" />
  </Fragment>

  <section class="page-section blog-content">
    <h1 class="section-title">
      {highlights.heading}
    </h1>

    <div class="feature-grid">
      {
        highlights.posts.map(
          (post) => {
            const label =
              getBlogLabel(
                post.data.labelId,
              );

            return (
              <FeaturedCard
                href={`/blog/${post.id}/`}
                eyebrow={`${label.name} / ${formatFeaturedDate(
                  post.data.date,
                )}`}
                title={post.data.title}
                text={post.data.description}
                image={post.data.cover}
                publishedAt={post.data.publishedAt}
              />
            );
          },
        )
      }
    </div>

    <JournalArchive posts={posts} />

    <div class="waitlist-card newsletter-bar">
      <div>
        <h2>
          keine Updates Verpassen
        </h2>

        <p>
          Erhalte eine Benachrichtigung,
          sobald ein neuer Artikel online ist.
        </p>
      </div>

      <SubscribeForm
        button="Benachrichtigen lassen"
      />
    </div>
  </section>
</BaseLayout>
